include README.md THIRD_PARTY_NOTICES.md LICENSE AGENTS.md
recursive-include licenses *.txt
recursive-include scripts *.py
recursive-include skill *.md *.py
recursive-include docs *.md
recursive-include tests *.py
prune .state
prune .venv
exclude skill/runtime.json
global-exclude *.pyc *.dpapi *.db *.dll *.exe
